# Regenerable: raw downloads, intermediate text pools, tokenized arrays.
data/raw/*
data/pools/*
data/tokens/*

# ...but keep the small stats files, which are the evidence behind numbers quoted in the
# README (supervised-token fraction, per-lane token counts, source checksums).
!data/raw/sources.json
!data/pools/pool_stats.json
!data/tokens/token_stats.json
